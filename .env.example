# 环境变量样例：复制为 .env 后按需修改，切勿把真实密钥提交到仓库
# 所有配置项前缀统一为 MOOC_

# 运行环境: dev | test | prod
MOOC_ENV=dev
MOOC_LOG_LEVEL=INFO

# HTTP 服务
MOOC_API_HOST=127.0.0.1
MOOC_API_PORT=8000
# CORS 白名单，逗号分隔。生产环境禁止使用 *
MOOC_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 目录（相对项目根目录）
MOOC_DATA_DIR=data
MOOC_ARTIFACTS_DIR=artifacts
MOOC_REPORTS_DIR=reports

# 代价矩阵（单位：元）。C_FN 为漏报代价（流失损失），C_FP 为误报代价（无效干预成本）
MOOC_COST_FN=1000.0
MOOC_COST_FP=100.0

# 特征窗口（天）：只用入学后前 N 天的行为预测最终是否辍学，防止数据穿越
MOOC_FEATURE_WINDOW_DAYS=14
# 时间衰减系数 lambda
MOOC_DECAY_LAMBDA=0.15
# 会话切分阈值（分钟）
MOOC_SESSION_GAP_MINUTES=30
